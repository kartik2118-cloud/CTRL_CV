# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# STT Provider options: mock, sarvam, whisper, groq, openai
STT_PROVIDER=mock

# Translation Provider options: mock (Step 3 will expand this)
TRANSLATION_PROVIDER=mock

# Sarvam AI API Key (for Indian languages: hi, mr, ta, te, kn, gu, etc.)
SARVAM_API_KEY=

# Whisper / Groq API Keys (for fast English/multilingual STT)
GROQ_API_KEY=
OPENAI_API_KEY=
