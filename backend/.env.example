# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# STT Provider options: mock, sarvam, whisper, groq, openai
# NOTE: Must be explicitly set to 'mock' if running without API keys.
STT_PROVIDER=mock

# Translation Provider options: mock, sarvam, groq, openai
# NOTE: Must be explicitly set to 'mock' if running without API keys.
TRANSLATION_PROVIDER=mock

# Sarvam AI API Key (for Indian languages: hi, mr, ta, te, kn, gu, etc.)
SARVAM_API_KEY=

# Whisper / Groq API Keys (for fast English/multilingual STT & translation)
GROQ_API_KEY=
OPENAI_API_KEY=

# Security & Access Controls (Task 5)
AUTH_TOKEN=
ALLOWED_ORIGINS=*
MAX_CHUNK_BYTES=262144
MAX_SESSIONS=20
IDLE_TIMEOUT_SECONDS=120
MAX_CHUNKS_PER_SECOND=5.0

# Robustness & Reliability (Task 6)
PROVIDER_TIMEOUT_SECONDS=8.0
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF=0.5
FALLBACK_STT_PROVIDER=
FALLBACK_TRANSLATION_PROVIDER=

# STT Audio Quality & Filtering (Task 7)
VAD_ENERGY_THRESHOLD=0.005
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_MIN_AVG_LOGPROB=-1.2
FILTER_HALLUCINATIONS=true
